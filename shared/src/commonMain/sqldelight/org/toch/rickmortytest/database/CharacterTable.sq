CREATE TABLE CharacterEntity (
    id INTEGER PRIMARY KEY,
    page INTEGER NOT NULL,
    name TEXT NOT NULL,
    status TEXT NOT NULL,
    species TEXT NOT NULL,
    gender TEXT NOT NULL,
    location TEXT NOT NULL,
    type TEXT NOT NULL,
    imageUrl TEXT NOT NULL,
    isFavorite INTEGER NOT NULL DEFAULT 0
);

CREATE VIRTUAL TABLE CharacterSearchIndex USING fts4(
    name,
    content='CharacterEntity'
);

CREATE TRIGGER character_before_insert BEFORE INSERT ON CharacterEntity BEGIN
    DELETE FROM CharacterSearchIndex WHERE rowid = new.id;
END;

CREATE TRIGGER character_after_insert AFTER INSERT ON CharacterEntity BEGIN
    INSERT INTO CharacterSearchIndex (rowid, name)
    VALUES (new.id, new.name);
END;

-- Query para guardar o actualizar un personaje
insertCharacter:
INSERT OR REPLACE INTO CharacterEntity(id, page, name, status, species, gender, location, type, imageUrl, isFavorite)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getCharactersByPage:
SELECT * FROM CharacterEntity WHERE page = ?;

countCharactersByPage:
SELECT COUNT(*) FROM CharacterEntity WHERE page = ?;

-- Query para obtener todos los personajes guardados
getFavoriteCharacter:
SELECT * FROM CharacterEntity WHERE isFavorite = 1;

updateFavoriteStatus:
UPDATE CharacterEntity SET isFavorite = ? WHERE id = ?;

-- Query para borrar por ID
deleteCharacter:
DELETE FROM CharacterEntity WHERE id = ?;

isCharacterFavorite:
SELECT COUNT(*) FROM CharacterEntity WHERE id = :id;

searchAllCharacter:
SELECT CharacterEntity.* FROM CharacterEntity
JOIN CharacterSearchIndex ON CharacterEntity.id = CharacterSearchIndex.rowid
WHERE CharacterSearchIndex MATCH :query;

searchLikeCharacter:
SELECT CharacterEntity.* FROM CharacterEntity
JOIN CharacterSearchIndex ON CharacterEntity.id = CharacterSearchIndex.rowid
WHERE CharacterSearchIndex MATCH :query
AND CharacterEntity.isFavorite = :isFavorite;

getCharacterFavoriteStatus:
SELECT isFavorite
FROM CharacterEntity
WHERE id = ?;