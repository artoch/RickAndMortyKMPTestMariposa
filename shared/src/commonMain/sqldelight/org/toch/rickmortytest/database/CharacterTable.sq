CREATE TABLE CharacterEntity (
    id INTEGER PRIMARY KEY,
    page INTEGER NOT NULL,
    name TEXT NOT NULL,
    status TEXT NOT NULL,
    species TEXT NOT NULL,
    gender TEXT NOT NULL,
    location TEXT NOT NULL,
    type TEXT NOT NULL,
    imageUrl TEXT NOT NULL,
    isFavorite INTEGER NOT NULL DEFAULT 0
);

-- Query para guardar o actualizar un personaje
insertCharacter:
INSERT OR REPLACE INTO CharacterEntity(id, page, name, status, species, gender, location, type, imageUrl, isFavorite)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getCharactersByPage:
SELECT * FROM CharacterEntity WHERE page = ?;

countCharactersByPage:
SELECT COUNT(*) FROM CharacterEntity WHERE page = ?;

-- Query para obtener todos los personajes guardados
getFavoriteCharacter:
SELECT * FROM CharacterEntity WHERE isFavorite = 1;

updateFavoriteStatus:
UPDATE CharacterEntity SET isFavorite = ? WHERE id = ?;

-- Query para borrar por ID
deleteCharacter:
DELETE FROM CharacterEntity WHERE id = ?;

isCharacterFavorite:
SELECT COUNT(*) FROM CharacterEntity WHERE id = :id;